# Polymarket Trading Bot — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit your .env file to version control.

# Your Polygon wallet private key (required for live trading)
POLYMARKET_PRIVATE_KEY=

# Funder address (required for proxy/Magic wallets, optional for EOA)
POLYMARKET_FUNDER_ADDRESS=

# Signature type: 0=EOA (MetaMask/hardware), 1=Magic/Email, 2=Browser
POLYMARKET_SIGNATURE_TYPE=0

# API credentials (generated via create_or_derive_api_creds())
# If left empty, the bot will derive them from your private key on first run
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Set to "true" for paper trading (default), "false" for live trading
POLYMARKET_DRY_RUN=true

# Log level: DEBUG, INFO, WARNING, ERROR
POLYMARKET_LOG_LEVEL=INFO
